    "dry-run": "wrangler deploy --dry-run --outdir ../../dist/mcp"
  },
  "dependencies": {
    "@cloudflare-obsidian-livesync/contracts": "0.1.0",
    "@cloudflare/workers-oauth-provider": "0.10.3",
    "@modelcontextprotocol/server": "2.0.0",
    "agents": "0.22.0",
    "zod": "4.5.4"
  }
}
